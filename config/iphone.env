# iphone-agent configuration — sourced by every script (lib/common.sh).
# Precedence: environment > config/local.env (git-ignored, your own values) >
# the defaults below. Put your UDID, team and bundle prefix in local.env.

# Phone UDID. Empty = auto-detect when exactly one iPhone is on USB.
IPHONE_UDID="${IPHONE_UDID:-}"

# Apple developer team that signs WebDriverAgent (Xcode → Settings → Accounts
# → your Apple ID → Team ID). A free "Personal Team" works but expires weekly.
DEVELOPMENT_TEAM="${DEVELOPMENT_TEAM:-}"            # required for scripts/wda-resign

# Must be unique per team; the installed runner is <prefix>.xctrunner.
WDA_BUNDLE_PREFIX="${WDA_BUNDLE_PREFIX:-com.example.WebDriverAgentRunner}"   # change it

# Pinned dependencies (scripts/setup installs them into var/)
WDA_REPO="${WDA_REPO:-https://github.com/appium/WebDriverAgent.git}"
WDA_REF="${WDA_REF:-a63279cfd54f5e5360c1ea9e31d706cabf316e29}"   # 16.1.7
GO_IOS_VERSION="${GO_IOS_VERSION:-1.3.2}"
MCP_SDK_VERSION="${MCP_SDK_VERSION:-2.2.0}"         # Python MCP SDK for bin/iphone-mcp

WDA_PORT="${WDA_PORT:-8100}"
WDA_MJPEG_PORT="${WDA_MJPEG_PORT:-9100}"   # screenshots (bin/wda shot)
