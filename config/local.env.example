# Copy to config/local.env (git-ignored) and fill in your own values.
# Loaded before config/iphone.env; environment variables still win.

# Phone UDID (Finder → iPhone, click the serial, or `var/bin/ios list`).
# Leave empty to auto-detect when exactly one iPhone is attached.
IPHONE_UDID="${IPHONE_UDID:-}"

# Apple developer Team ID: Xcode → Settings → Accounts → your Apple ID.
DEVELOPMENT_TEAM="${DEVELOPMENT_TEAM:-}"

# A bundle id prefix that is yours (e.g. com.yourname.WebDriverAgentRunner).
WDA_BUNDLE_PREFIX="${WDA_BUNDLE_PREFIX:-}"

# Optional: extra regex for the MCP confirmation gate, for labels in your
# language (send / pay / delete …), e.g. "(senden|bezahlen|löschen)".
IPHONE_MCP_EXTRA_RISKY="${IPHONE_MCP_EXTRA_RISKY:-}"

# Optional: minutes without tool calls before the MCP server stops the agent.
# IPHONE_MCP_IDLE_MIN=10
